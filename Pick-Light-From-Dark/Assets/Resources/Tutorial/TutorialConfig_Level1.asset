  levelId: 1
  steps:
  - stepId: lv1_welcome
    targetObjectName: 
    instructionText: "\u6DF1\u591C\u7684\u5BBF\u820D\u91CC\uFF0C\u4F60\u9700\u8981\u6084\u6084\u884C\u52A8\uFF0C\u5B8C\u6210\u81EA\u5DF1\u7684\u4E8B\u60C5\u3002\n\u4F46\u8981\u5C0F\u5FC3\u2014\u2014\u5BBF\u7BA1\u8001\u5E08\u6B63\u5728\u8D70\u5ECA\u91CC\u5DE1\u903B\uFF0C\u901A\u8FC7\u542C\u811A\u6B65\u58F0\u6765\u5224\u65AD\u3002"
    cutoutSize: {x: 0, y: 0}
    cutoutAnchor: 0
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 2
    trigger: 2
  - stepId: lv1_card_area
    targetObjectName: CreateCardZone
    instructionText: "\u8FD9\u91CC\u662F\u4F60\u7684\u884C\u52A8\u5361\u724C\u3002\n\u5C06\u5361\u724C\u62D6\u5165\u4E0B\u65B9\u7684\u601D\u8003\u6846\u4E2D\u5373\u53EF\u4F7F\u7528\u3002"
    cutoutSize: {x: 380, y: 380}
    cutoutAnchor: 1
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 2
    trigger: 2
  - stepId: lv1_thinkbox
    targetObjectName: SetCardZone
    instructionText: "\u8FD9\u662F\u601D\u8003\u6846\u2014\u2014\u677E\u624B\u540E\u5361\u724C\u5F00\u59CB\u8BFB\u6761\u3002\n\u7EFF\u8272\u6BB5\u843D\u53EF\u4EE5\u6309\u7A7A\u683C\u952E\u6253\u65AD\uFF0C\u7EA2\u8272\u6BB5\u843D\u65E0\u6CD5\u6253\u65AD\u3002"
    cutoutSize: {x: 400, y: 240}
    cutoutAnchor: 0
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 2
    trigger: 2
  - stepId: lv1_emotion
    targetObjectName: PlayerMessage
    instructionText: "\u5DE6\u4E0B\u89D2\u662F\u4F60\u7684\u60C5\u7EEA\u503C\u3002\u70B9\u51FB\u53EF\u67E5\u770B\u614C\u4E71\u503C\u4E0E\u5174\u594B\u503C\u7684\u8BE6\u60C5\u3002\n\u7EFF\u8272=\u5B89\u5168 
      \u9EC4\u8272=\u8B66\u544A  \u7EA2\u8272=\u5371\u9669"
    cutoutSize: {x: 480, y: 480}
    cutoutAnchor: 2
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 1
    trigger: 2
  - stepId: lv1_eyeclose
    targetObjectName: CloseEyesBtn
    instructionText: "\u8FD9\u662F\u95ED\u773C\u6309\u94AE\uFF08\u6216\u6309 C \u952E\uFF09\u3002\n\u95ED\u4E0A\u773C\u775B\u53EF\u4EE5\u88C5\u7761\uFF0C\u964D\u4F4E\u614C\u4E71\u503C\u3002"
    cutoutSize: {x: 160, y: 160}
    cutoutAnchor: 0
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 2
    trigger: 2
  - stepId: lv1_teacher_warning
    targetObjectName: TeacherStatus
    instructionText: "\u5F53\u811A\u6B65\u58F0\u9010\u6E10\u9760\u8FD1\u7684\u65F6\u5019\uFF0C\u7ACB\u523B\u56DE\u5230\u5E8A\u4E0A\uFF0C\u786E\u4FDD\u81EA\u5DF1\uFF1A\n\u2713
      \u8EBA\u5728\u5E8A\u4E0A  \u2713 \u95ED\u4E0A\u773C\u775B  \u2713 \u60C5\u7EEA\u503C\u4E0D\u8D85\u8FC780"
    cutoutSize: {x: 0, y: 0}
    cutoutAnchor: 0
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 1
    trigger: 2
  - stepId: lv1_task
    targetObjectName: EventImgBk
    instructionText: "\u5C4F\u5E55\u53F3\u4FA7\u662F\u4ECA\u665A\u8981\u5B8C\u6210\u7684\u4EFB\u52A1\u6E05\u5355\u3002\n\u5168\u90E8\u5B8C\u6210\u540E\u5373\u53EF\u8FC7\u5173\u3002"
    cutoutSize: {x: 340, y: 230}
    cutoutAnchor: 0
    cutoutOffset: {x: 0, y: 0}
    showMask: 1
    indicator: 2
    trigger: 2
  - stepId: lv1_end
    targetObjectName: HpImg
    instructionText: "\u4F60\u53EA\u6709 2 \u70B9\u751F\u547D\u503C\u3002\u88AB\u8001\u5E08\u6293\u4F4F
      2 \u6B21\u5C31\u4F1A\u5F3A\u5236\u9000\u5B66\u3002\n\u795D\u4F60\u597D\u8FD0\uFF01"
